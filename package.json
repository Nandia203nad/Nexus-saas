{
  "name": "nexus-saas",
  "version": "5.0.0",
  "description": "Nexus — Content SaaS Platform with Skill Tree, Follow System, Stripe, Supabase",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && next build",
    "start": "next start",
