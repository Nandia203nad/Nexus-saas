generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Plan {
  FREE
  PREMIUM
  MAX
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  password             String
  name                 String
  avatar               String?
  bio                  String?
  website              String?
  role                 Role     @default(USER)
  plan                 Plan     @default(FREE)
  xp                   Int      @default(0)
  level                Int      @default(1)
  streak               Int      @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  blogs          Blog[]
  comments       Comment[]
  likes          Like[]
  bookmarks      Bookmark[]
  skills         UserSkill[]
  achievements   UserAchievement[]
  questProgress  QuestProgress[]
  portfolioFiles PortfolioFile[]
  topicComments  SkillTopicComment[]
  topicReactions SkillTopicReaction[]
  topicProgress  SkillTopicProgress[]
  quizAttempts   SkillTopicQuizAttempt[]
  following      Follow[]     @relation("follower")
  followers      Follow[]     @relation("following")
  badgesEarned   UserBadge[]

  @@index([email])
  @@index([xp])
  @@index([plan])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Badge {
  id          String    @id @default(cuid())
  name        String    @unique
  description String
  icon        String
  color       String    @default("#00f0ff")
  xpRequired  Int       @default(0)
  condition   String
  usersEarned UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  @@id([userId, badgeId])
}

model PortfolioFile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   @default("analysis")
  content   String
  size      Int      @default(0)
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Blog {
  id         String   @id @default(cuid())
  title      String
  content    String
  excerpt    String?
  coverImage String?
  published  Boolean  @default(false)
  isPremium  Boolean  @default(false)
  minPlan    Plan     @default(FREE)
  readTime   Int      @default(5)
  views      Int      @default(0)
  xpReward   Int      @default(20)
  category   String   @default("general")
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  tags      PostTag[]

  @@index([authorId])
  @@index([published])
  @@index([category])
  @@index([createdAt])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  color String    @default("#00f0ff")
  posts PostTag[]
}

model PostTag {
  blogId String
  tagId  String
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([blogId, tagId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  blogId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([blogId])
  @@index([authorId])
}

model Like {
  userId    String
  blogId    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  @@id([userId, blogId])
}

model Bookmark {
  userId    String
  blogId    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  @@id([userId, blogId])
}

model Skill {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  icon         String?
  category     String
  xpRequired   Int         @default(100)
  prerequisites String?
  userSkills   UserSkill[]
}

model UserSkill {
  userId     String
  skillId    String
  xp         Int      @default(0)
  level      Int      @default(0)
  unlockedAt DateTime @default(now())
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([userId, skillId])
}

model Achievement {
  id               String            @id @default(cuid())
  name             String
  description      String
  icon             String
  xpReward         Int               @default(50)
  condition        String
  userAchievements UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  @@id([userId, achievementId])
}

model Quest {
  id            String          @id @default(cuid())
  title         String
  description   String
  xpReward      Int             @default(100)
  conditions    Json
  isActive      Boolean         @default(true)
  questProgress QuestProgress[]
}

model QuestProgress {
  userId      String
  questId     String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  @@id([userId, questId])
}

model Video {
  id        String   @id @default(cuid())
  title     String
  author    String
  duration  String   @default("00:00")
  views     String   @default("0")
  category  String   @default("marketing")
  level     String   @default("Beginner")
  xp        Int      @default(50)
  youtubeId String
  desc      String   @db.Text
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model SkillTopicComment {
  id        String   @id @default(cuid())
  topicId   String
  content   String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([authorId])
  @@index([createdAt])
}

model SkillTopicReaction {
  topicId   String
  userId    String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([topicId, userId, type])
  @@index([topicId])
  @@index([userId])
}

model SkillTopicProgress {
  topicId     String
  userId      String
  read        Boolean  @default(false)
  readAt      DateTime?
  quizPassed  Boolean  @default(false)
  quizScore   Int      @default(0)
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([topicId, userId])
  @@index([userId])
}

model SkillTopicQuizAttempt {
  id        String   @id @default(cuid())
  topicId   String
  userId    String
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([userId])
}
